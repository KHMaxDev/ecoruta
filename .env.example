# =============================================================================
# EcoRuta — Variables de Entorno de Ejemplo
# Copiar a `.env` y rellenar con credenciales reales. NUNCA versionar `.env`.
# =============================================================================

# --- Base de Datos Geoespacial (PostgreSQL 16 + PostGIS 3.4 + pgRouting 3.6) ---
POSTGRES_USER=ecoruta_user
POSTGRES_PASSWORD=ecoruta_secure_password
POSTGRES_DB=ecoruta_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ecoruta_user:ecoruta_secure_password@localhost:5432/ecoruta_db
DATABASE_URL_SYNC=postgresql+psycopg2://ecoruta_user:ecoruta_secure_password@localhost:5432/ecoruta_db

# --- Redis (caché de consultas) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=900
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# --- Motor de enrutamiento base Valhalla ---
VALHALLA_URL=http://localhost:8002

# --- INEGI — API SAKBÉ v3.1 (rutas de referencia y peajes) ---
INEGI_SAKBE_BASE_URL=https://gaia.inegi.org.mx/sakbe_v3.1
INEGI_SAKBE_TOKEN=

# --- CNE — Precios de gasolinas y diésel ---
CNE_FUEL_ENDPOINT=https://cne.gob.mx/api/.../precios
CNE_ENDPOINT_URL=https://cne.gob.mx/api/.../precios
CNE_FUEL_MAX_AGE_HOURS=72

# --- Open-Meteo / SMN CONAGUA ---
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Azure Maps Traffic (opcional, Fase 2) ---
AZURE_MAPS_KEY=

# --- Parámetros de la región piloto (corredor CDMX-Puebla-Toluca por defecto) ---
PILOT_BBOX_MIN_LON=-100.5
PILOT_BBOX_MIN_LAT=18.8
PILOT_BBOX_MAX_LON=-98.0
PILOT_BBOX_MAX_LAT=20.2
DEM_GEOTIFF_PATH=./data/raw/dem_piloto.tif
RNC_ROADS_PATH=./data/raw/rnc_vialidades.gpkg
RNC_TOLLS_PATH=./data/raw/rnc_casetas.gpkg

# --- API Backend ---
# Nota: NO usar el puerto 8000 si otro servicio local (p. ej. `php artisan serve`) lo ocupa.
API_HOST=0.0.0.0
API_PORT=8010
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8010
